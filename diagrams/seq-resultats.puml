@startuml
scale 1.5
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBackgroundColor #EEF5FF
skinparam sequenceParticipantBorderColor #3366CC

actor "Administration" as A
participant "Système" as S
database "SGBD" as DB

A -> S : Détermine le résultat final

S -> DB : SELECT noteFinale\nWHERE soutenance = ?
DB --> S : Note finale

alt Résultat : admis
  S -> DB : UPDATE affectation\n(statut = validée)
  S -> DB : UPDATE soutenance\n(résultat = admis)
  DB --> S : Confirmation
  S -> DB : INSERT notification\n(étudiant : PFE admis)
else Résultat : corrections requises
  S -> DB : UPDATE soutenance\n(résultat = corrections_requises)
  DB --> S : Confirmation
  S -> DB : INSERT notification\n(étudiant : corrections requises)
else Résultat : non admis
  S -> DB : UPDATE affectation\n(statut = refusée)
  S -> DB : UPDATE soutenance\n(résultat = non_admis)
  DB --> S : Confirmation
  S -> DB : INSERT notification\n(étudiant : PFE non admis)
end

S --> A : Résultat enregistré
@enduml
