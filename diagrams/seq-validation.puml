@startuml
scale 1.5
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBackgroundColor #EEF5FF
skinparam sequenceParticipantBorderColor #3366CC

actor "Enseignant\n(Validateur)" as V
participant "Système" as S
database "SGBD" as DB

V -> S : Consulte le sujet à évaluer
S -> DB : SELECT sujet WHERE id = ?
DB --> S : Données du sujet
S --> V : Affiche les détails du sujet

V -> S : Soumet sa décision\n(validé / accepté sous réserve / refusé)\navec commentaire
S -> DB : UPDATE sujet\n(décision du validateur)
DB --> S : Confirmation

S -> DB : SELECT décisions des deux validateurs
DB --> S : Décisions

alt Les deux validateurs valident
  S -> DB : UPDATE sujet (statut = validé)
  S -> DB : INSERT notification (proposant : sujet validé)
else Au moins un validateur refuse
  S -> DB : UPDATE sujet (statut = refusé)
  S -> DB : INSERT notification (proposant : sujet refusé)
else Accepté sous réserve
  S -> DB : UPDATE sujet (statut = accepté_sous_réserve)
  S -> DB : INSERT notification (proposant : modifications requises)
end
@enduml
