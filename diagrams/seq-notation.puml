@startuml
scale 1.5
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBackgroundColor #EEF5FF
skinparam sequenceParticipantBorderColor #3366CC

actor "Enseignant\n(Membre du jury)" as J
participant "Système" as S
database "SGBD" as DB

J -> S : Soumet ses notes\n(critères 1 à 4, chacun sur 4)
S -> S : Valide les notes\n(chaque critère entre 0 et 4)
S -> DB : INSERT note_jury\n(critere1, critere2, critere3, critere4)
DB --> S : Confirmation

S -> DB : SELECT toutes les notes\ndu jury et du superviseur
DB --> S : Notes collectées

alt Toutes les notes soumises
  S -> S : Calcule la note finale\n(somme des 5 critères = /20)
  S -> DB : UPDATE soutenance\n(noteFinale = ?)
  DB --> S : Confirmation
  S -> DB : INSERT notification\n(administration : notation complète)
else Notes manquantes
  S -> DB : INSERT notification\n(rappel aux évaluateurs)
end
@enduml
