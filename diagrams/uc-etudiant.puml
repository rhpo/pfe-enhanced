@startuml
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EEF5FF
  BorderColor #3366CC
  ArrowColor #3366CC
}

actor "Étudiant" as E

rectangle "Système de Gestion des PFE" {
  usecase "S'authentifier" as UC1
  usecase "Gérer son profil" as UC2
  usecase "Soumettre une FichePFE" as UC3
  usecase "Consulter le statut de sa FichePFE" as UC4
  usecase "Renseigner une FicheSuiviPFE" as UC5
  usecase "Consulter l'historique de suivi" as UC6
  usecase "Consulter le planning de soutenance" as UC7
  usecase "Consulter le résultat de l'évaluation" as UC8
  usecase "Consulter les PFE publiés" as UC9
}

E --> UC1
E --> UC2
E --> UC3
E --> UC4
E --> UC5
E --> UC6
E --> UC7
E --> UC8
E --> UC9

UC3 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC4 ..> UC3 : <<extend>>
@enduml
