@startuml
scale 1.5
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBackgroundColor #EEF5FF
skinparam sequenceParticipantBorderColor #3366CC

actor "Administration" as A
participant "Système" as S
database "SGBD" as DB

A -> S : Constitue le jury\n(président + membre)
S -> DB : SELECT enseignants disponibles
DB --> S : Liste des enseignants
S -> DB : INSERT jury_soutenance\n(président, membre)
DB --> S : Confirmation
S -> DB : INSERT notifications\n(membres du jury : demande de confirmation)

A -> S : Planifie la soutenance\n(date, heure, salle)
S -> DB : INSERT soutenance\n(date, salle, échéance)
DB --> S : Confirmation
S -> DB : INSERT notifications\n(étudiant, jury, superviseur)
S --> A : Soutenance planifiée
@enduml
